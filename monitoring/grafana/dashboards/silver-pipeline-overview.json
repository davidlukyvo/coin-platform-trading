    {"id":52,"type":"stat","title":"BingX collector","gridPos":{"x":4,"y":41,"w":4,"h":5},"targets":[{"expr":"up{job=\"bingx-collector\"}","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]},"overrides":[]}},
    {"id":53,"type":"stat","title":"Silver processor","gridPos":{"x":8,"y":41,"w":4,"h":5},"targets":[{"expr":"up{job=\"silver-processor\"}","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]},"overrides":[]}},
    {"id":54,"type":"stat","title":"Quality exporter","gridPos":{"x":12,"y":41,"w":4,"h":5},"targets":[{"expr":"up{job=\"silver-quality-exporter\"}","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]},"overrides":[]}},
    {"id":55,"type":"stat","title":"Seconds since Silver success","gridPos":{"x":16,"y":41,"w":4,"h":5},"targets":[{"expr":"time()-silver_last_success_unixtime","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"unit":"s","decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":120},{"color":"red","value":180}]}},"overrides":[]}},
    {"id":56,"type":"stat","title":"Silver storage","gridPos":{"x":20,"y":41,"w":4,"h":5},"targets":[{"expr":"coin_platform_storage_bytes{area=\"silver\"}","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"unit":"bytes","decimals":1,"color":{"mode":"fixedColor","fixedColor":"blue"}},"overrides":[]}},

    {"id":60,"type":"row","title":"Engineering Detail","collapsed":false,"gridPos":{"x":0,"y":46,"w":24,"h":1},"panels":[]},
    {"id":61,"type":"timeseries","title":"Processing and write rate","gridPos":{"x":0,"y":47,"w":12,"h":8},"targets":[{"expr":"rate(silver_records_processed_total[5m])","legendFormat":"processed","refId":"A"},{"expr":"rate(silver_records_written_total[5m])","legendFormat":"written","refId":"B"}],"fieldConfig":{"defaults":{"unit":"ops","min":0},"overrides":[]}},
    {"id":62,"type":"timeseries","title":"Rejected and duplicates","gridPos":{"x":12,"y":47,"w":12,"h":8},"targets":[{"expr":"rate(silver_records_rejected_total[5m])","legendFormat":"rejected","refId":"A"},{"expr":"rate(silver_duplicates_total[5m])","legendFormat":"duplicates dropped","refId":"B"}],"fieldConfig":{"defaults":{"unit":"ops","min":0},"overrides":[]}},
    {"id":63,"type":"timeseries","title":"Batch duration p95","gridPos":{"x":0,"y":55,"w":8,"h":8},"targets":[{"expr":"histogram_quantile(0.95,sum by(le)(rate(silver_batch_duration_seconds_bucket[5m])))","legendFormat":"p95","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s","min":0},"overrides":[]}},
    {"id":64,"type":"timeseries","title":"Silver storage growth","gridPos":{"x":8,"y":55,"w":8,"h":8},"targets":[{"expr":"deriv(coin_platform_storage_bytes{area=\"silver\"}[1h])","legendFormat":"growth","refId":"A"}],"fieldConfig":{"defaults":{"unit":"Bps"},"overrides":[]}},
    {"id":65,"type":"timeseries","title":"Pipeline lag","gridPos":{"x":16,"y":55,"w":8,"h":8},"targets":[{"expr":"silver_lag_seconds","legendFormat":"processor lag","refId":"A"},{"expr":"max(silver_symbol_lag_seconds)","legendFormat":"worst symbol lag","refId":"B"}],"fieldConfig":{"defaults":{"unit":"s","min":0},"overrides":[]}},
    {"id":66,"type":"stat","title":"Committed source offset (engineering only)","description":"Highest committed byte offset. This is not backlog because source size is not part of this metric.","gridPos":{"x":0,"y":63,"w":6,"h":5},"targets":[{"expr":"silver_checkpoint_offset","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"unit":"decbytes","decimals":0,"color":{"mode":"fixedColor","fixedColor":"blue"}},"overrides":[]}},
    {"id":67,"type":"stat","title":"Write errors — 24h","gridPos":{"x":6,"y":63,"w":6,"h":5},"targets":[{"expr":"increase(silver_write_errors_total[24h])","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}},"overrides":[]}},
    {"id":68,"type":"stat","title":"Growth — 24h","gridPos":{"x":12,"y":63,"w":6,"h":5},"targets":[{"expr":"coin_platform_storage_bytes{area=\"silver\"} - coin_platform_storage_bytes{area=\"silver\"} offset 24h","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"unit":"bytes","decimals":1,"color":{"mode":"fixedColor","fixedColor":"blue"}},"overrides":[]}},
    {"id":69,"type":"stat","title":"Projected 30-day growth","description":"Linear projection from the last 24 hours; informational only.","gridPos":{"x":18,"y":63,"w":6,"h":5},"targets":[{"expr":"30 * clamp_min(coin_platform_storage_bytes{area=\"silver\"} - coin_platform_storage_bytes{area=\"silver\"} offset 24h, 0)","instant":true,"refId":"A"}],"fieldConfig":{"defaults":{"unit":"bytes","decimals":1,"color":{"mode":"fixedColor","fixedColor":"blue"}},"overrides":[]}}
