COMPOSE_PROJECT_NAME=coin-platform
TZ=Asia/Ho_Chi_Minh

# Host path mounted from the dedicated Ubuntu data disk.
COIN_DATA_ROOT=/data/coin-platform

POSTGRES_DB=coin_platform
POSTGRES_USER=coin_platform
POSTGRES_PASSWORD=change-me-locally

BINANCE_WS_BASE=wss://stream.binance.com:9443
EXCHANGE=binance
MARKET_SYMBOLS=btcusdt,ethusdt
MARKET_STREAMS=aggTrade,kline_1m
COLLECTOR_LOG_LEVEL=INFO
COLLECTOR_METRICS_PORT=8000
COLLECTOR_QUEUE_SIZE=10000
COLLECTOR_STALE_AFTER_SECONDS=60
COLLECTOR_RECONNECT_MAX_SECONDS=60
COLLECTOR_WRITE_MAX_ATTEMPTS=5

# Public BingX Spot market data; no API key and no trading permissions.
BINGX_WS_BASE=wss://open-api-ws.bingx.com/market
BINGX_MARKET_SYMBOLS=BTC-USDT,ETH-USDT
BINGX_MARKET_STREAMS=trade,kline_1m
BINGX_COLLECTOR_LOG_LEVEL=INFO
BINGX_COLLECTOR_QUEUE_SIZE=5000
BINGX_COLLECTOR_STALE_AFTER_SECONDS=60
BINGX_COLLECTOR_RECONNECT_MAX_SECONDS=60

# BingX account UI. It is intentionally localhost-only; use an SSH tunnel.
# Real API credentials are never stored in this file.
BINGX_REST_BASE=https://open-api.bingx.com
SYSTEM_TRADING_BIND_ADDRESS=127.0.0.1
SYSTEM_TRADING_PORT=8443
SYSTEM_TRADING_SECRET_ROOT=./secrets/system-trading
SYSTEM_TRADING_TLS_ROOT=./secrets/system-trading-tls

# Paper-only trading. This service has no exchange credentials or Internet route.
PAPER_DATA_EXCHANGE=binance
PAPER_SYMBOLS=BTCUSDT,ETHUSDT
PAPER_INTERVAL_SECONDS=60
PAPER_STARTING_CASH=10000
PAPER_TARGET_NOTIONAL=100
PAPER_FEE_BPS=4
PAPER_SLIPPAGE_BPS=2
PAPER_KILL_SWITCH=false
RISK_MAX_ORDER_NOTIONAL=100
RISK_MAX_SYMBOL_POSITION=150
RISK_MAX_GROSS_EXPOSURE=250
RISK_MAX_DAILY_LOSS=25
RISK_MAX_DRAWDOWN_FRACTION=0.02
RISK_MAX_TRADES_PER_DAY=20
RISK_MAX_MARKET_AGE_SECONDS=3900

# Monitoring UI. Bind to the VM LAN address only when LAN access is required.
MONITORING_BIND_ADDRESS=127.0.0.1
GRAFANA_SERVER_DOMAIN=localhost
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally

SILVER_INTERVAL_SECONDS=60
SILVER_BATCH_MAX_BYTES=16777216
SILVER_MIN_BATCH_BYTES=4194304
SILVER_METRICS_PORT=8010
SILVER_LOG_LEVEL=INFO
